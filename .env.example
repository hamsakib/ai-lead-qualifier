# Copy to .env and fill in. Never commit .env.

# Which model scores leads:
#   gemini     FREE: Google Gemini free tier. Key from https://aistudio.google.com/apikey (no card)
#   ollama     FREE: a model on this computer. Install Ollama, then: ollama pull qwen2.5:3b
#   anthropic  Claude API (paid, prepaid credit at console.anthropic.com)
PROVIDER=gemini

# For PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# For PROVIDER=ollama
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_URL=http://localhost:11434

# For PROVIDER=anthropic: your Anthropic API key (console.anthropic.com -> API keys)
ANTHROPIC_API_KEY=

# Model used for scoring. Default is claude-opus-5-5.
# claude-haiku-5-5 is the low-cost option for high lead volume.
MODEL=claude-opus-5-5

# Required: shared secret the form/website sends in the x-webhook-secret header
WEBHOOK_SECRET=change-me-to-a-long-random-string

# Optional: HubSpot private-app token (scopes: crm.objects.contacts.write, crm.objects.contacts.read)
HUBSPOT_TOKEN=

# Optional: Slack incoming-webhook URL for hot-lead alerts
SLACK_WEBHOOK_URL=

# Leads scoring at or above this get a Slack alert
HOT_LEAD_SCORE=7

PORT=3000
